# Copy to .env.local (local) or set in your host's environment settings. Never commit real values.

# --- Database (Neon free tier). Two roles, see src/db/roles.sql ---
DATABASE_URL=            # read-only role (site_read): every page and the public API
DATABASE_URL_WRITE=      # read/write role (site_write): sync, webhook, admin
DATABASE_URL_OWNER=      # owner role: only for `npm run db:migrate` (never on the website)

# --- Site ---
SITE_URL=https://www.example.com   # public address (read at build): canonical URLs, sitemaps, share cards; also used by the sync to refresh pages
SITE_INDEXABLE=                    # set to 1 on the production build only; anything else keeps search engines out
CF_ANALYTICS_TOKEN=                # Cloudflare Web Analytics site token (public, cookieless); empty = no analytics

# --- Point-of-sale sync ---
POS_WEBHOOK_SECRET=      # shared secret for signing POST /api/webhooks/pos (long random string)
REVALIDATE_TOKEN=        # bearer token the scheduled sync uses to refresh pages (long random string)

# --- Contact form (all four needed to send; otherwise the form asks people to call) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=   # Cloudflare Turnstile site key (public)
TURNSTILE_SECRET_KEY=             # Cloudflare Turnstile secret
RESEND_API_KEY=                   # Resend API key (free tier: 3,000 emails/month)
CONTACT_TO=                       # store inbox that receives messages
CONTACT_FROM=                     # verified sender, e.g. "Adams Shore website <web@yourdomain.com>"

# --- Admin (Cloudflare Access, free for up to 50 users) ---
CF_ACCESS_TEAM_DOMAIN=   # e.g. https://adams-shore.cloudflareaccess.com
CF_ACCESS_AUD=           # Access application audience tag
ADMIN_EMAILS=            # comma-separated staff emails allowed into /admin
# ADMIN_DEV_EMAIL=you@example.com   # local development only; ignored in production
